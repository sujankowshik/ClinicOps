/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, physicians, and their associated data.
 * Only authenticated users can access patient, physician, or inventory item documents.
 * Visits are nested under patients and are only accessible to the owning user.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient profiles, accessible only to the patient.
 * - /patients/{patientId}/visits/{visitId}: Stores visit records, accessible only to the patient.
 * - /appointments/{appointmentId}: Stores appointment information, accessible to any authenticated user.
 * - /inventory_items/{inventoryItemId}: Stores inventory data, accessible only to authenticated users.
 * - /physicians/{physicianId}: Stores physician profiles, accessible only to the physician.
 *
 * Key Security Decisions:
 * - No user listing is allowed for patients or physicians.
 * - All write operations are validated against the authenticated user's UID to ensure ownership.
 * - Appointments are accessible to all authenticated users, reflecting a collaborative access model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the patient profiles. Only the patient can create, read, update, or delete their profile.
     * @path /patients/{patientId}
     * @allow (create) User with UID 'patientId' can create their profile.
     * @allow (get) User with UID 'patientId' can read their profile.
     * @allow (update) User with UID 'patientId' can update their profile.
     * @allow (delete) User with UID 'patientId' can delete their profile.
     * @deny (create) User with UID 'otherId' cannot create a profile with ID 'patientId'.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.id == patientId;
      allow update: if isSignedIn() && isExistingOwner(patientId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Secures the visit records under a patient. Only the patient can create, read, update, or delete their visit records.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) User with UID 'patientId' can create a visit record under their profile.
     * @allow (get) User with UID 'patientId' can read a visit record under their profile.
     * @allow (update) User with UID 'patientId' can update a visit record under their profile.
     * @allow (delete) User with UID 'patientId' can delete a visit record under their profile.
     * @deny (create) User with UID 'otherId' cannot create a visit record under patient 'patientId'.
     * @principle Enforces document ownership and hierarchy for all operations.
     */
    match /patients/{patientId}/visits/{visitId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.patientId == patientId;
      allow update: if isSignedIn() && isExistingOwner(patientId) && resource.data.patientId == patientId;
      allow delete: if isSignedIn() && isExistingOwner(patientId) && resource.data.patientId == patientId;
    }

    /**
     * @description Secures the appointment records. Any authenticated user can create, read, update, or delete appointment records.
     * @path /appointments/{appointmentId}
     * @allow (create) Any authenticated user can create an appointment.
     * @allow (get) Any authenticated user can read an appointment.
     * @allow (update) Any authenticated user can update an appointment.
     * @allow (delete) Any authenticated user can delete an appointment.
     * @principle Allows open access to appointments for authenticated users.
     */
    match /appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Secures the inventory items. Only authenticated users can create, read, update, or delete inventory item records.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) Any authenticated user can create an inventory item.
     * @allow (get) Any authenticated user can read an inventory item.
     * @allow (update) Any authenticated user can update an inventory item.
     * @allow (delete) Any authenticated user can delete an inventory item.
     * @principle Allows open access to inventory for authenticated users.
     */
    match /inventory_items/{inventoryItemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Secures the physician profiles. Only the physician can create, read, update, or delete their profile.
     * @path /physicians/{physicianId}
     * @allow (create) User with UID 'physicianId' can create their profile.
     * @allow (get) User with UID 'physicianId' can read their profile.
     * @allow (update) User with UID 'physicianId' can update their profile.
     * @allow (delete) User with UID 'physicianId' can delete their profile.
     * @deny (create) User with UID 'otherId' cannot create a profile with ID 'physicianId'.
     * @principle Enforces document ownership for all operations.
     */
    match /physicians/{physicianId} {
      allow get: if isSignedIn() && isOwner(physicianId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(physicianId) && request.resource.data.id == physicianId;
      allow update: if isSignedIn() && isExistingOwner(physicianId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(physicianId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}