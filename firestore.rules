/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, physicians, and inventory items.
 * Appointments are accessible to any authenticated user.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information, with `patientId` as the document ID.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for each patient, with `visitId` as the document ID.
 * - /appointments/{appointmentId}: Stores appointment information, with `appointmentId` as the document ID.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information, with `inventoryItemId` as the document ID.
 * - /physicians/{physicianId}: Stores physician information, with `physicianId` as the document ID.
 *
 * Key Security Decisions:
 * - Path-based ownership is enforced for patients and their visits.
 * - Anyone authenticated can create, read, update, or delete appointment documents.
 * - Listing of patients, physicians, and inventory items is restricted to authenticated users.
 *
 * Denormalization for Authorization:
 *  N/A - The current design relies on path-based ownership and does not require denormalization.
 *
 * Structural Segregation:
 * The database segregates data by entity type (patients, visits, appointments, inventory items, physicians) into separate collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure patient documents. Only the patient can read, update, or delete their own document.
     * @path /patients/{patientId}
     * @allow (create) - User 'patient_abc' creates a new patient document with id 'patient_abc'. request.auth.uid == 'patient_abc'
     * @allow (get, update, delete) - User 'patient_abc' reads, updates, or deletes their patient document with id 'patient_abc'. request.auth.uid == 'patient_abc'
     * @deny (create) - User 'other_user' attempts to create a patient document with id 'patient_abc'. request.auth.uid != 'patient_abc'
     * @deny (get, update, delete) - User 'other_user' attempts to read, update, or delete patient document with id 'patient_abc'. request.auth.uid != 'patient_abc'
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isSignedIn() && isExistingOwner(patientId);
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Secure visit documents under a patient. Only the patient can create, read, update, or delete their own visit documents.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) - User 'patient_abc' creates a new visit document under patient 'patient_abc'. request.auth.uid == 'patient_abc'
     * @allow (get, update, delete) - User 'patient_abc' reads, updates, or deletes a visit document under patient 'patient_abc'. request.auth.uid == 'patient_abc'
     * @deny (create) - User 'other_user' attempts to create a visit document under patient 'patient_abc'. request.auth.uid != 'patient_abc'
     * @deny (get, update, delete) - User 'other_user' attempts to read, update, or delete a visit document under patient 'patient_abc'. request.auth.uid != 'patient_abc'
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /patients/{patientId}/visits/{visitId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isSignedIn() && isExistingParentOwner(patientId);
      allow delete: if isSignedIn() && isExistingParentOwner(patientId);
    }

    /**
     * @description Allows any authenticated user to create, read, update, or delete appointment documents.
     * @path /appointments/{appointmentId}
     * @allow (create, get, list, update, delete) - Any authenticated user can manage appointments.
     * @principle Allows open access to appointments for any authenticated user.
     */
    match /appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secure inventory item documents. Only authenticated users can create, read, update, or delete inventory item documents.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, list, update, delete) - Any authenticated user can manage inventory items.
     * @principle Restricts access to authenticated users.
     */
    match /inventory_items/{inventoryItemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secure physician documents. Only authenticated users can create, read, update, or delete physician documents.
     * @path /physicians/{physicianId}
     * @allow (create) - User 'physician_abc' creates a new physician document with id 'physician_abc'. request.auth.uid == 'physician_abc'
     * @allow (get, update, delete) - User 'physician_abc' reads, updates, or deletes their physician document with id 'physician_abc'. request.auth.uid == 'physician_abc'
     * @deny (create) - User 'other_user' attempts to create a physician document with id 'physician_abc'. request.auth.uid != 'physician_abc'
     * @deny (get, update, delete) - User 'other_user' attempts to read, update, or delete physician document with id 'physician_abc'. request.auth.uid != 'physician_abc'
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /physicians/{physicianId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(physicianId);
      allow update: if isSignedIn() && isExistingOwner(physicianId);
      allow delete: if isSignedIn() && isExistingOwner(physicianId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    function isExistingParentOwner(patientId) {
        return get(/databases/$(database)/documents/patients/$(patientId)).data.id == request.auth.uid && resource != null;
    }
  }
}