/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, visits, physicians and inventory items.
 * Appointments are accessible to all authenticated users.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a specific patient.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed unless explicitly stated otherwise.
 * - All write operations are protected by authorization checks.
 *
 * Denormalization for Authorization:
 * - The rules leverage path-based ownership, eliminating the need for `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the /patients/{patientId} collection, ensuring only the authenticated user matching the patient ID can access patient documents.
     * @path /databases/{database}/documents/patients/{patientId}
     * @allow (create, get, update, delete, list) if the authenticated user's UID matches the patientId.
     *   Example:
     *   - Allowed: User with UID "user123" creates a document at /patients/user123.
     *   - Allowed: User with UID "user123" reads, updates, or deletes the document at /patients/user123.
     * @deny (create, get, update, delete, list) if the authenticated user's UID does not match the patientId.
     *   Example:
     *   - Denied: User with UID "user456" attempts to read the document at /patients/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId} {
      function isOwner(patientId) {
        return request.auth != null && request.auth.uid == patientId;
      }
      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isOwner(patientId);
      allow list: if false;
      allow create: if isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Secures the /patients/{patientId}/visits/{visitId} subcollection, ensuring only the authenticated user matching the patient ID can access visit documents.
     * @path /databases/{database}/documents/patients/{patientId}/visits/{visitId}
     * @allow (create, get, update, delete, list) if the authenticated user's UID matches the patientId.
     *   Example:
     *   - Allowed: User with UID "user123" creates a document at /patients/user123/visits/visit456.
     *   - Allowed: User with UID "user123" reads, updates, or deletes the document at /patients/user123/visits/visit456.
     * @deny (create, get, update, delete, list) if the authenticated user's UID does not match the patientId.
     *   Example:
     *   - Denied: User with UID "user456" attempts to read the document at /patients/user123/visits/visit456.
     * @principle Enforces document ownership for all operations on the subcollection.
     */
    match /patients/{patientId}/visits/{visitId} {
      function isOwner(patientId) {
        return request.auth != null && request.auth.uid == patientId;
      }
      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);
      allow create: if isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Secures the /appointments/{appointmentId} collection, allowing any authenticated user to access appointment documents.
     * @path /databases/{database}/documents/appointments/{appointmentId}
     * @allow (create, get, update, delete, list) if the user is authenticated.
     *   Example:
     *   - Allowed: Any authenticated user can create a document at /appointments/app123.
     *   - Allowed: Any authenticated user can read, update, or delete the document at /appointments/app123.
     * @deny (create, get, update, delete, list) if the user is not authenticated.
     *   Example:
     *   - Denied: Unauthenticated user attempts to read the document at /appointments/app123.
     * @principle Allows all authenticated users to access appointments.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isExisting() {
        return resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExisting();
      allow delete: if isSignedIn() && isExisting();
    }

    /**
     * @description Secures the /inventory_items/{inventoryItemId} collection, ensuring only authenticated users can access inventory item documents.
     * @path /databases/{database}/documents/inventory_items/{inventoryItemId}
     * @allow (create, get, update, delete, list) if the user is authenticated.
     *   Example:
     *   - Allowed: Authenticated user creates a document at /inventory_items/item123.
     *   - Allowed: Authenticated user reads, updates, or deletes the document at /inventory_items/item123.
     * @deny (create, get, update, delete, list) if the user is not authenticated.
     *   Example:
     *   - Denied: Unauthenticated user attempts to read the document at /inventory_items/item123.
     * @principle Requires authentication for all operations on inventory items.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }
       function isExisting() {
        return resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExisting();
      allow delete: if isSignedIn() && isExisting();
    }

    /**
     * @description Secures the /physicians/{physicianId} collection, ensuring only the authenticated user matching the physician ID can access physician documents.
     * @path /databases/{database}/documents/physicians/{physicianId}
     * @allow (create, get, update, delete, list) if the authenticated user's UID matches the physicianId.
     *   Example:
     *   - Allowed: User with UID "user123" creates a document at /physicians/user123.
     *   - Allowed: User with UID "user123" reads, updates, or deletes the document at /physicians/user123.
     * @deny (create, get, update, delete, list) if the authenticated user's UID does not match the physicianId.
     *   Example:
     *   - Denied: User with UID "user456" attempts to read the document at /physicians/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /physicians/{physicianId} {
      function isOwner(physicianId) {
        return request.auth != null && request.auth.uid == physicianId;
      }
      function isExistingOwner(physicianId) {
        return isOwner(physicianId) && resource != null;
      }

      allow get: if isOwner(physicianId);
      allow list: if false;
      allow create: if isOwner(physicianId);
      allow update: if isExistingOwner(physicianId);
      allow delete: if isExistingOwner(physicianId);
    }
  }
}