/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, visits, physicians and inventory items.
 * Appointments are accessible to any authenticated user.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a specific patient.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User listing is disallowed for all collections, except where noted.
 * - Read and write access to patient and physician data is restricted to authenticated users.
 * - Appointments can be created, read, updated, or deleted by any authenticated user.
 * - The rules explicitly deny unauthorized access attempts.
 *
 * Denormalization for Authorization:
 *  N/A - Rules rely on path-based ownership and authenticated user ID. No denormalization needed.
 *
 * Structural Segregation:
 *  Data with similar access requirements are stored in the same collections, enhancing security and performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines whether the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines whether the user is the owner of the document, based on the document ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isOwner(patientId) {
      return request.auth.uid == patientId;
    }

    /**
     * @description Defines whether the user is the owner of the existing document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
    }

    /**
     * @description Rules for the /patients/{patientId} collection.
     * @path /patients/{patientId}
     * @allow (create) User with UID 'test_user' can create a patient document where patientId == 'test_user'.
     * @deny (create) User with UID 'other_user' cannot create a patient document where patientId == 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /patients/{patientId} {
      // Read rules
      allow get: if isSignedIn();
      allow list: if false;

      // Write rules
      allow create: if isSignedIn() && isOwner(patientId) ;
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Rules for the /patients/{patientId}/visits/{visitId} collection.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) User with UID 'test_user' can create a visit document under a patient document they own.
     * @deny (create) User with UID 'other_user' cannot create a visit document under patient 'test_user'.
     * @principle Enforces document ownership for writes in a subcollection.
     */
    match /patients/{patientId}/visits/{visitId} {
      // Read rules
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);

      // Write rules
      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Rules for the /appointments/{appointmentId} collection.
     * @path /appointments/{appointmentId}
     * @allow (create) Any authenticated user can create an appointment.
     * @deny (create) Unauthenticated user cannot create an appointment.
     * @principle Allows any authenticated user to manage appointments.
     */
    match /appointments/{appointmentId} {
      // Read rules
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Write rules
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /inventory_items/{inventoryItemId} collection.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) Any authenticated user can create an inventory item.
     * @deny (create) Unauthenticated user cannot create an inventory item.
     * @principle Restricts inventory management to authenticated users.
     */
    match /inventory_items/{inventoryItemId} {
      // Read rules
      allow get: if isSignedIn();
      allow list: if false;

      // Write rules
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /physicians/{physicianId} collection.
     * @path /physicians/{physicianId}
     * @allow (create) User with UID 'test_user' can create a physician document where physicianId == 'test_user'.
     * @deny (create) User with UID 'other_user' cannot create a physician document where physicianId == 'test_user'.
     * @principle Enforces document ownership for writes.
     */
    match /physicians/{physicianId} {
      // Read rules
      allow get: if isSignedIn();
      allow list: if false;

      // Write rules
      allow create: if isSignedIn() && isOwner(physicianId);
      allow update: if isExistingOwner(physicianId);
      allow delete: if isExistingOwner(physicianId);
    }
  }
}