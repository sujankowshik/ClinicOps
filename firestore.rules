/**
 * @file Firestore Security Rules for Clinic Ops 2.0
 * @core_philosophy This ruleset enforces a strict user-ownership model for patient data and general authentication for other data,
 * ensuring only authenticated users can access specific resources.
 * @data_structure The database is structured with patients, physicians, and inventory items stored in top-level collections.
 * Patient visits are stored in a subcollection under each patient.
 * @key_security_decisions
 * - All write operations require authentication.
 * - List operations for patient-owned data are restricted to the owner.
 * - The rules do not implement data validation beyond authorization checks for rapid prototyping.
 * @denormalization Not applicable. Path-based ownership is used.
 * @structural_segregation Not applicable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to patient documents.
     * @path /patients/{patientId}
     * @allow (create) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can create a patient document if the patientId matches the UID.
     * @deny (create) User with UID 'randomUID' cannot create a patient document under /patients/patientId.
     * @allow (get) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can get a patient document if the patientId matches the UID.
     * @deny (get) User with UID 'randomUID' cannot get a patient document under /patients/patientId.
     * @allow (update) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can update a patient document if the patientId matches the UID and the document exists.
     * @deny (update) User with UID 'randomUID' cannot update a patient document under /patients/patientId.
     * @allow (delete) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can delete a patient document if the patientId matches the UID and the document exists.
     * @deny (delete) User with UID 'randomUID' cannot delete a patient document under /patients/patientId.
     * @allow (list) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can list patient documents if the patientId matches the UID.
     * @deny (list) User with UID 'randomUID' cannot list patient documents under /patients/patientId.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.id == patientId;
      allow update: if isSignedIn() && isExistingOwner(patientId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Controls access to patient visit documents.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can create a visit document if the patientId matches the UID.
     * @deny (create) User with UID 'randomUID' cannot create a visit document under /patients/patientId/visits/visitId.
     * @allow (get) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can get a visit document if the patientId matches the UID.
     * @deny (get) User with UID 'randomUID' cannot get a visit document under /patients/patientId/visits/visitId.
     * @allow (update) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can update a visit document if the patientId matches the UID and the document exists.
     * @deny (update) User with UID 'randomUID' cannot update a visit document under /patients/patientId/visits/visitId.
     * @allow (delete) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can delete a visit document if the patientId matches the UID and the document exists.
     * @deny (delete) User with UID 'randomUID' cannot delete a visit document under /patients/patientId/visits/visitId.
     * @allow (list) User with UID 'Mx4ckhLzHfhTVwAVSn0dhZ2LJ0G3' can list visit documents if the patientId matches the UID.
     *  @deny (list) User with UID 'randomUID' cannot list visit documents under /patients/patientId/visits/visitId.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId}/visits/{visitId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.patientId == patientId;
      allow update: if isSignedIn() && isOwner(patientId) && resource != null && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isSignedIn() && isOwner(patientId) && resource != null;
    }

    /**
     * @description Controls access to appointment documents.
     * @path /appointments/{appointmentId}
     * @allow (create) Any authenticated user can create an appointment document.
     * @deny (create) Unauthorized user cannot create an appointment document.
     * @allow (get) Any authenticated user can get an appointment document.
     * @deny (get) Unauthorized user cannot get an appointment document.
     * @allow (update) Any authenticated user can update an appointment document if it exists.
     * @deny (update) Unauthorized user cannot update an appointment document.
     * @allow (delete) Any authenticated user can delete an appointment document if it exists.
     * @deny (delete) Unauthorized user cannot delete an appointment document.
     * @allow (list) Any authenticated user can list appointment documents.
     * @deny (list) Unauthorized user cannot list appointment documents.
     * @principle Allows any authenticated user to manage appointment data.
     */
    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to inventory item documents.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) Any authenticated user can create an inventory item document.
     * @deny (create) Unauthorized user cannot create an inventory item document.
     * @allow (get) Any authenticated user can get an inventory item document.
     * @deny (get) Unauthorized user cannot get an inventory item document.
     * @allow (update) Any authenticated user can update an inventory item document if it exists.
     * @deny (update) Unauthorized user cannot update an inventory item document.
     * @allow (delete) Any authenticated user can delete an inventory item document if it exists.
     * @deny (delete) Unauthorized user cannot delete an inventory item document.
     * @allow (list) Any authenticated user can list inventory item documents.
     * @deny (list) Unauthorized user cannot list inventory item documents.
     * @principle Requires authentication for all operations.
     */
    match /inventory_items/{inventoryItemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to physician documents.
     * @path /physicians/{physicianId}
     * @allow (create) Any authenticated user can create a physician document.
     * @deny (create) Unauthorized user cannot create a physician document.
     * @allow (get) Any authenticated user can get a physician document.
     * @deny (get) Unauthorized user cannot get a physician document.
     * @allow (update) Any authenticated user can update a physician document if it exists.
     * @deny (update) Unauthorized user cannot update a physician document.
     * @allow (delete) Any authenticated user can delete a physician document if it exists.
     * @deny (delete) Unauthorized user cannot delete a physician document.
     * @allow (list) Any authenticated user can list physician documents.
     * @deny (list) Unauthorized user cannot list physician documents.
     * @principle Requires authentication for all operations.
     */
    match /physicians/{physicianId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Helper function to determine if the user is the owner of the existing document.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}