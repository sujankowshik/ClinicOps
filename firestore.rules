/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy: This ruleset enforces a strict authentication-based access model.
 * Only authenticated users can interact with the database. Authorization is based on
 * document ownership, meaning a user can only access documents where the document ID matches their user ID.
 *
 * Data Structure: The database is structured with top-level collections for each major entity:
 * /patients/{patientId}
 * /appointments/{appointmentId}
 * /inventory_items/{inventoryItemId}
 * /physicians/{physicianId}
 *
 * Key Security Decisions:
 * - All collections require user authentication for all operations.
 * - List operations are restricted to authenticated users.
 * - The appointment documents do not enforce ownership, only authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the /patients collection, allowing only authenticated users to manage patient data.
     * @path /patients/{patientId}
     * @allow (create) - Authenticated user creates a patient document where patientId matches their UID.
     * @deny (create) - Unauthenticated user attempts to create a patient document.
     * @allow (get, list, update, delete) - Authenticated user accesses a patient document where patientId matches their UID.
     * @deny (get, list, update, delete) - Authenticated user attempts to access a patient document where patientId does not match their UID.
     * @principle Enforces document ownership for writes.
     */
    match /patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      // Read rules
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Write rules
      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Secures the /appointments collection, allowing only authenticated users to manage appointment data.
     * @path /appointments/{appointmentId}
     * @allow (create) - Authenticated user creates a appointment document.
     * @deny (create) - Unauthenticated user attempts to create a appointment document.
     * @allow (get, list, update, delete) - Authenticated user accesses a appointment document.
     * @deny (get, list, update, delete) - Unauthenticated user attempts to access a appointment document.
     * @principle Enforces authentication for all operations on appointments.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Read rules
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Write rules
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures the /inventory_items collection, allowing only authenticated users to manage inventory item data.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) - Authenticated user creates a inventory_item document where inventoryItemId matches their UID.
     * @deny (create) - Unauthenticated user attempts to create a inventory_item document.
     * @allow (get, list, update, delete) - Authenticated user accesses a inventory_item document where inventoryItemId matches their UID.
     * @deny (get, list, update, delete) - Authenticated user attempts to access a inventory_item document where inventoryItemId does not match their UID.
     * @principle Enforces document ownership for writes.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Read rules
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Write rules
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secures the /physicians collection, allowing only authenticated users to manage physician data.
     * @path /physicians/{physicianId}
     * @allow (create) - Authenticated user creates a physician document where physicianId matches their UID.
     * @deny (create) - Unauthenticated user attempts to create a physician document.
     * @allow (get, list, update, delete) - Authenticated user accesses a physician document where physicianId matches their UID.
     * @deny (get, list, update, delete) - Authenticated user attempts to access a physician document where physicianId does not match their UID.
     * @principle Enforces document ownership for writes.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Read rules
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Write rules
      allow create: if isSignedIn() && isOwner(physicianId);
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}