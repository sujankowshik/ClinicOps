/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for patient, visit, physician, and inventory data,
 * ensuring that only authenticated users can access and modify resources.
 * Appointments are accessible to any authenticated user.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a specific patient.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User data (patients, visits, physicians, inventory) is protected using path-based ownership,
 *   where the {patientId}, {physicianId}, or {inventoryItemId} must match the authenticated user's UID.
 * - Appointments are accessible to any authenticated user.
 * - List operations are secured based on ownership, ensuring that users can only list data they own.
 * - The rules explicitly deny any unauthorized access attempts.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for patient documents. Only the patient (owner) can create, read, update, or delete their own patient document.
     * @path /patients/{patientId}
     * @allow (create) - User with UID 'user123' can create a patient document with ID 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can get, update, or delete a patient document with ID 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a patient document with ID 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete a patient document with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Enforces access control for visit documents. Only the patient (owner) can create, read, update, or delete their own visit documents.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) - User with UID 'user123' can create a visit document under patient 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can get, update, or delete a visit document under patient 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a visit document under patient 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete a visit document under patient 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId}/visits/{visitId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }

       function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && request.resource.data.patientId == patientId;
      allow update: if isExistingOwner(patientId) && resource.data.patientId == patientId;
      allow delete: if isExistingOwner(patientId) && resource.data.patientId == patientId;
    }

    /**
     * @description Allows any authenticated user to create, read, update, or delete appointment documents.
     * @path /appointments/{appointmentId}
     * @allow (create, get, update, delete) - Any authenticated user can perform all operations on appointment documents.
     * @deny (none) - There are no explicit deny conditions for authenticated users.
     * @principle Allows open access to appointment data for authenticated users.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Enforces access control for inventory item documents. Only authenticated users can create, read, update, or delete inventory item documents.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, update, delete) - Any authenticated user can perform all operations on inventory item documents.
     * @deny (none) - There are no explicit deny conditions for authenticated users.
     * @principle Allows open access to inventory item data for authenticated users.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Enforces access control for physician documents. Only the physician (owner) can create, read, update, or delete their own physician document.
     * @path /physicians/{physicianId}
     * @allow (create) - User with UID 'user123' can create a physician document with ID 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can get, update, or delete a physician document with ID 'user123'.
     * @deny (create) - User with UID 'user456' cannot create a physician document with ID 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot get, update, or delete a physician document with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(physicianId) {
        return request.auth.uid == physicianId;
      }

       function isExistingOwner(physicianId) {
        return isOwner(physicianId) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(physicianId);
      allow update: if isExistingOwner(physicianId);
      allow delete: if isExistingOwner(physicianId);
    }
  }
}