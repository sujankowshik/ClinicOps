/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, visits, physicians and inventory items.
 * Only authenticated users can access data, and they can only access data related to their own patient record or general clinic resources.
 *
 * Data Structure:
 * - Patients are stored under `/patients/{patientId}`.
 * - Patient visits are stored in a subcollection under each patient: `/patients/{patientId}/visits/{visitId}`.
 * - Physicians are stored under `/physicians/{physicianId}`.
 * - Appointments are stored under `/appointments/{appointmentId}`,
 * - Inventory items are stored under `/inventory_items/{inventoryItemId}`.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed to prevent information disclosure.
 * - All write operations are carefully validated to ensure data integrity.
 *
 * Denormalization for Authorization:
 *  N/A - Rules rely on path-based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to patient documents.
     * @path /patients/{patientId}
     * @allow (create) - Authenticated user creates a patient document with their user ID as the patientId.
     * @deny (create) - Attempt to create a patient document with a patientId that doesn't match the user's ID.
     * @allow (get, list) - Authenticated user gets or lists their own patient document.
     * @deny (get, list) - Attempt to get or list a patient document that doesn't belong to the user.
     * @allow (update, delete) - Authenticated user updates or deletes their own patient document.
     * @deny (update, delete) - Attempt to update or delete a patient document that doesn't belong to the user.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return isSignedIn() && request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
          return isOwner(patientId) && resource != null;
      }

      allow create: if isOwner(patientId);
      allow get: if isOwner(patientId);
      allow list: if false;
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Secure access to patient visit documents.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) - Authenticated user creates a visit document under their patient document.
     * @deny (create) - Attempt to create a visit document under a patient document that doesn't belong to the user.
     * @allow (get, list) - Authenticated user gets or lists visit documents under their patient document.
     * @deny (get, list) - Attempt to get or list visit documents under a patient document that doesn't belong to the user.
     * @allow (update, delete) - Authenticated user updates or deletes visit documents under their patient document.
     * @deny (update, delete) - Attempt to update or delete visit documents under a patient document that doesn't belong to the user.
     * @principle Enforces document ownership for all operations.
     */
    match /patients/{patientId}/visits/{visitId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return isSignedIn() && request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
          return isOwner(patientId) && resource != null;
      }

      allow create: if isOwner(patientId);
      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Secure access to appointment documents.
     * @path /appointments/{appointmentId}
     * @allow (create, get, list, update, delete) - Any authenticated user can create, read, update, or delete appointment documents.
     * @principle Allows any authenticated user to access appointment data.
     */
    match /appointments/{appointmentId} {
       function isSignedIn() {
        return request.auth != null;
      }
      allow create: if isSignedIn();
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secure access to inventory item documents.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, list, update, delete) - Only authenticated users can create, read, update, or delete inventory item documents.
     * @principle Requires authentication for all operations on inventory items.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow create: if isSignedIn();
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Secure access to physician documents.
     * @path /physicians/{physicianId}
     * @allow (create, get, list, update, delete) - Only authenticated users can create, read, update, or delete physician documents.
     * @principle Requires authentication for all operations on physician data.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow create: if isSignedIn();
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}