/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, visits, physicians and inventory items.
 * Appointments are accessible to all authenticated users.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a specific patient.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Read-only collections are not used in this version.
 * - The default security posture is strict: deny all access unless explicitly allowed.
 *
 * Authorization Independence:
 * - All rules rely on `request.auth.uid` and existence checks to avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages patient data.
     * @path /patients/{patientId}
     * @allow (create) - Authenticated user with matching patientId can create a patient document.
     * @allow (get, list) - Authenticated user with matching patientId can read/list a patient document.
     * @allow (update, delete) - Authenticated user with matching patientId can update/delete a patient document.
     * @deny (create) - Authenticated user with a non-matching patientId cannot create a patient document.
     * @principle Enforces document ownership for writes.
     */
    match /patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return isSignedIn() && request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isOwner(patientId);
      allow list: if false;

      allow create: if isOwner(patientId) && request.resource.data.id == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(patientId);
    }

     /**
      * @description Manages patient visit data.
      * @path /patients/{patientId}/visits/{visitId}
      * @allow (create) - Authenticated user with matching patientId can create a visit document.
      * @allow (get, list) - Authenticated user with matching patientId can read/list a visit document.
      * @allow (update, delete) - Authenticated user with matching patientId can update/delete a visit document.
      * @deny (create) - Authenticated user with a non-matching patientId cannot create a visit document.
      * @principle Enforces document ownership for writes.
      */
    match /patients/{patientId}/visits/{visitId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isOwner(patientId) {
            return isSignedIn() && request.auth.uid == patientId;
        }

        function isExistingOwner(patientId) {
            return isOwner(patientId) && resource != null;
        }

        allow get: if isOwner(patientId);
        allow list: if isOwner(patientId);

        allow create: if isOwner(patientId) && request.resource.data.patientId == patientId;
        allow update: if isExistingOwner(patientId) && request.resource.data.patientId == resource.data.patientId;
        allow delete: if isExistingOwner(patientId);
    }


    /**
     * @description Manages appointment data.
     * @path /appointments/{appointmentId}
     * @allow (create) - Any authenticated user can create an appointment document.
     * @allow (get, list) - Any authenticated user can read/list an appointment document.
     * @allow (update, delete) - Any authenticated user can update/delete an appointment document.
     * @deny (create) - No condition under which creation should be denied for authenticated users.
     * @principle Allows any authenticated user to manage appointments.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages inventory item data.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) - Authenticated user can create an inventory item document.
     * @allow (get, list) - Authenticated user can read/list an inventory item document.
     * @allow (update, delete) - Authenticated user can update/delete an inventory item document.
     * @deny (create) - No condition under which creation should be denied for authenticated users.
     * @principle Allows any authenticated user to manage inventory items.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages physician data.
     * @path /physicians/{physicianId}
     * @allow (create) - Authenticated user with matching physicianId can create a physician document.
     * @allow (get, list) - Authenticated user with matching physicianId can read/list a physician document.
     * @allow (update, delete) - Authenticated user with matching physicianId can update/delete a physician document.
     * @deny (create) - Authenticated user with a non-matching physicianId cannot create a physician document.
     * @principle Enforces document ownership for writes.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(physicianId) {
        return isSignedIn() && request.auth.uid == physicianId;
      }

      function isExistingOwner(physicianId) {
        return isOwner(physicianId) && resource != null;
      }

      allow get: if isOwner(physicianId);
      allow list: if false;

      allow create: if isOwner(physicianId) && request.resource.data.id == physicianId;
      allow update: if isExistingOwner(physicianId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(physicianId);
    }
  }
}