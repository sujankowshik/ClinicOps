/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, physicians, and inventory items.
 * Only authenticated users can access these resources. Appointments can be accessed by anyone authenticated.
 * Path-based ownership is enforced using the `request.auth.uid`.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores patient visit information.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed unless explicitly required.
 * - Data validation is minimized for prototyping but critical authorization fields are validated.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rule set for patient documents. Only authenticated users can manage patient data.
     * @path /patients/{patientId}
     * @allow (create) - Authenticated user creates a new patient document where the patientId matches their UID.
     * @allow (get, list, update, delete) - Authenticated user accesses their own patient document where the patientId matches their UID.
     * @deny (create) - Unauthenticated user attempts to create a patient document.
     * @principle Enforces document ownership for writes.
     */
    match /patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }

      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }
      
      allow get: if isOwner(patientId);
      allow list: if false; // Listing patients is not allowed.

      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Rule set for visit subcollection. Only the authenticated patient can manage their visit data.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) - Authenticated patient creates a new visit document under their patient document.
     * @allow (get, list, update, delete) - Authenticated patient accesses their own visit documents.
     * @deny (create) - Unauthenticated user attempts to create a visit document.
     * @deny (create) - Authenticated user attempts to create a visit document under another patient's document.
     * @principle Restricts access to a user's own data tree.
     */
    match /patients/{patientId}/visits/{visitId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }
      
      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);

      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Rule set for appointment documents. Any authenticated user can manage appointment data.
     * @path /appointments/{appointmentId}
     * @allow (create, get, list, update, delete) - Any authenticated user can manage appointment documents.
     * @deny (create, get, list, update, delete) - Unauthenticated user attempts to access appointment documents.
     * @principle Allows any authenticated user access to appointments.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Rule set for inventory item documents. Only authenticated users can manage inventory item data.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, list, update, delete) - Authenticated user manages inventory item documents.
     * @deny (create, get, list, update, delete) - Unauthenticated user attempts to access inventory item documents.
     * @principle Requires authentication for inventory management.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Rule set for physician documents. Only authenticated users can manage physician data.
     * @path /physicians/{physicianId}
     * @allow (create, get, list, update, delete) - Authenticated user manages physician documents.
     * @deny (create, get, list, update, delete) - Unauthenticated user attempts to access physician documents.
     * @principle Requires authentication for physician data management.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}