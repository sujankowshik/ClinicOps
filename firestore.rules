/**
 * @file Firestore Security Rules for Clinic Ops 2.0
 * @core_philosophy This ruleset enforces a strict user-ownership model for patient data and general authentication for other collections, with the goal of preventing unauthorized data access.
 * @data_structure The database is structured with patients and physicians at the top level, each identified by a unique ID. Patient visits are stored as subcollections under each patient. Appointments and inventory items are stored in their own top-level collections.
 * @key_security_decisions
 *   - Patient and visit data is strictly controlled by patient ID in the path.
 *   - Physician and inventory data is accessible only to authenticated users.
 *   - Appointments are accessible to any authenticated user.
 *   - List operations are restricted to owners for user-scoped subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to patient documents.
     * @path /patients/{patientId}
     * @allow (create) Authenticated user can create a patient document if the ID matches their UID.
     * @allow (read) Authenticated user can read a patient document if the ID matches their UID.
     * @allow (update) Authenticated user can update a patient document if the ID matches their UID and the document exists.
     * @allow (delete) Authenticated user can delete a patient document if the ID matches their UID and the document exists.
     * @deny (create) An unauthenticated user cannot create a patient document.
     * @deny (read) An unauthenticated user cannot read a patient document.
     * @deny (update) An unauthenticated user cannot update a patient document.
     * @deny (delete) An unauthenticated user cannot delete a patient document.
     * @principle Enforces document ownership for all operations based on the patient ID in the path.
     */
    match /patients/{patientId} {
      // Helper function to check if the authenticated user is the owner of the patient document.
      function isOwner(patientId) {
        return request.auth != null && request.auth.uid == patientId;
      }

      // Helper function to check if the authenticated user is the owner of an existing patient document.
      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }

      allow get: if isOwner(patientId);
      allow list: if false;
      allow create: if isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Controls access to visit documents nested under patient documents.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) Authenticated user can create a visit document if they own the parent patient document.
     * @allow (read) Authenticated user can read a visit document if they own the parent patient document.
     * @allow (update) Authenticated user can update a visit document if they own the parent patient document and the visit document exists.
     * @allow (delete) Authenticated user can delete a visit document if they own the parent patient document and the visit document exists.
     * @deny (create) An unauthenticated user cannot create a visit document.
     * @deny (read) An unauthenticated user cannot read a visit document.
     * @deny (update) An unauthenticated user cannot update a visit document.
     * @deny (delete) An unauthenticated user cannot delete a visit document.
     * @principle Enforces document ownership for all operations based on the patient ID in the path.
     */
    match /patients/{patientId}/visits/{visitId} {
      // Reuse the isOwner function from the /patients/{patientId} match block.
      function isOwner(patientId) {
        return request.auth != null && request.auth.uid == patientId;
      }

      // Helper function to check if the authenticated user is the owner of an existing patient document.
      function isExistingOwner(patientId) {
        return isOwner(patientId) && resource != null;
      }
        
      allow get: if isOwner(patientId);
      allow list: if isOwner(patientId);
      allow create: if isOwner(patientId);
      allow update: if isExistingOwner(patientId);
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Controls access to appointment documents.
     * @path /appointments/{appointmentId}
     * @allow (create) Any authenticated user can create an appointment document.
     * @allow (read) Any authenticated user can read an appointment document.
     * @allow (update) Any authenticated user can update an appointment document if it exists.
     * @allow (delete) Any authenticated user can delete an appointment document if it exists.
     * @deny (create) An unauthenticated user cannot create an appointment document.
     * @deny (read) An unauthenticated user cannot read an appointment document.
     * @deny (update) An unauthenticated user cannot update an appointment document.
     * @deny (delete) An unauthenticated user cannot delete an appointment document.
     * @principle Allows any authenticated user to perform CRUD operations on appointment documents.
     */
    match /appointments/{appointmentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to inventory item documents.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create) Any authenticated user can create an inventory item document.
     * @allow (read) Any authenticated user can read an inventory item document.
     * @allow (update) Any authenticated user can update an inventory item document if it exists.
     * @allow (delete) Any authenticated user can delete an inventory item document if it exists.
     * @deny (create) An unauthenticated user cannot create an inventory item document.
     * @deny (read) An unauthenticated user cannot read an inventory item document.
     * @deny (update) An unauthenticated user cannot update an inventory item document.
     * @deny (delete) An unauthenticated user cannot delete an inventory item document.
     * @principle Allows any authenticated user to perform CRUD operations on inventory item documents.
     */
    match /inventory_items/{inventoryItemId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to physician documents.
     * @path /physicians/{physicianId}
     * @allow (create) Any authenticated user can create a physician document.
     * @allow (read) Any authenticated user can read a physician document.
     * @allow (update) Any authenticated user can update a physician document if it exists.
     * @allow (delete) Any authenticated user can delete a physician document if it exists.
     * @deny (create) An unauthenticated user cannot create a physician document.
     * @deny (read) An unauthenticated user cannot read a physician document.
     * @deny (update) An unauthenticated user cannot update a physician document.
     * @deny (delete) An unauthenticated user cannot delete a physician document.
     * @principle Allows any authenticated user to perform CRUD operations on physician documents.
     */
    match /physicians/{physicianId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }
}