/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, visits, physicians and inventory items.
 * Appointments are open to all authenticated users.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a given patient.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory item information.
 * - /physicians/{physicianId}: Stores physician information.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - All write operations are explicitly authorized. There is NO open write rule.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure all paths by default
     */
    match /{path=**} {
      allow read, write: if false;
    }

    /**
     * @description Grants access to patient documents for authenticated users, based on patient ID.
     * @path /patients/{patientId}
     * @allow (create) - An authenticated user can create a patient document where the patientId matches their UID.
     * @allow (get, list, update, delete) - An authenticated user can read, update, or delete a patient document where the patientId matches their UID.
     * @deny (create) - An authenticated user cannot create a patient document where the patientId does not match their UID.
     * @deny (update, delete) - An unauthenticated user cannot update or delete any patient document.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing all patients is not permitted

      allow create: if isSignedIn() && request.auth.uid == patientId;
      allow update: if isSignedIn() && isExistingOwner(patientId);
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Grants access to visit documents within a patient's subcollection for authenticated users, based on patient ID.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) - An authenticated user can create a visit document under a patient document where the patientId matches their UID.
     * @allow (get, list, update, delete) - An authenticated user can read, update, or delete a visit document under a patient document where the patientId matches their UID.
     * @deny (create) - An authenticated user cannot create a visit document under a patient document where the patientId does not match their UID.
     * @deny (update, delete) - An unauthenticated user cannot update or delete any visit document.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /patients/{patientId}/visits/{visitId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOwner(patientId); // Modified to allow listing by the owner

      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isSignedIn() && isExistingOwner(patientId);
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Grants access to appointment documents for any authenticated user.
     * @path /appointments/{appointmentId}
     * @allow (create, get, list, update, delete) - Any authenticated user can create, read, update, or delete appointment documents.
     * @deny (create, get, list, update, delete) - An unauthenticated user cannot create, read, update, or delete appointment documents.
     */
    match /appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants access to inventory item documents for authenticated users.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, list, update, delete) - Any authenticated user can create, read, update, or delete inventory item documents.
     * @deny (create, get, list, update, delete) - An unauthenticated user cannot create, read, update, or delete inventory item documents.
     */
    match /inventory_items/{inventoryItemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants access to physician documents for authenticated users.
     * @path /physicians/{physicianId}
     * @allow (create, get, list, update, delete) - Any authenticated user can create, read, update, or delete physician documents.
     * @deny (create, get, list, update, delete) - An unauthenticated user cannot create, read, update, or delete physician documents.
     */
    match /physicians/{physicianId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document based on the provided user ID.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the document and if the document exists.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}