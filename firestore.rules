/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model combined with path-based authorization, meaning users can only access data explicitly associated with their own user ID. This ensures data privacy and prevents unauthorized access. All read and write operations are protected by authentication checks.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient profiles, accessible only to the patient.
 * - /patients/{patientId}/visits/{visitId}: Stores visit records for each patient, accessible only to the associated patient.
 * - /appointments/{appointmentId}: Stores appointment details. Accessible to any authenticated user.
 * - /inventory_items/{inventoryItemId}: Stores inventory data. Accessible to any authenticated user.
 * - /physicians/{physicianId}: Stores physician profiles, accessible to any authenticated user.
 *
 * Key Security Decisions:
 * - No user listing: Listing of users (patients or physicians) is explicitly denied to prevent information leakage.
 * - Strict ownership: Only the authenticated user matching the document ID can create, read, update, or delete their own patient document.
 * - Public read access for appointments, physicians, and inventory items for authenticated users.
 * - Denormalization for Authorization:  No external data lookups are performed during authorization. The rules rely solely on the `request.auth.uid` and the document path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures patient profiles, ensuring only the patient can access their own data.
     * @path /patients/{patientId}
     */
    match /patients/{patientId} {
      //Verified identity
      function isSignedIn() {
        return request.auth != null;
      }
      //Verified ownership
      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }
      //Check existing ownership
      function isExistingOwner(patientId) {
        return (isOwner(patientId) && exists(resource));
      }

      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isSignedIn() && isExistingOwner(patientId);
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Secures patient visit records, ensuring only the associated patient can access their visit history.
     * @path /patients/{patientId}/visits/{visitId}
     */
    match /patients/{patientId}/visits/{visitId} {
      //Verified identity
      function isSignedIn() {
        return request.auth != null;
      }
      //Verified ownership
      function isOwner(patientId) {
        return request.auth.uid == patientId;
      }
      //Check existing ownership
      function isExistingOwner(patientId) {
        return (isOwner(patientId) && exists(resource));
      }

      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(patientId);
      allow update: if isSignedIn() && isExistingOwner(patientId);
      allow delete: if isSignedIn() && isExistingOwner(patientId);
    }

    /**
     * @description Secures appointment records, allowing any authenticated user to create, read, update, or delete appointment documents.
     * @path /appointments/{appointmentId}
     */
    match /appointments/{appointmentId} {
      //Verified identity
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Secures inventory items, allowing any authenticated user to create, read, update, or delete inventory items.
     * @path /inventory_items/{inventoryItemId}
     */
    match /inventory_items/{inventoryItemId} {
      //Verified identity
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Secures physician profiles, allowing any authenticated user to create, read, update, or delete physician documents.
     * @path /physicians/{physicianId}
     */
    match /physicians/{physicianId} {
      //Verified identity
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}