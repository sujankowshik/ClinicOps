/**
 * @fileoverview Firestore Security Rules for Clinic Ops 2.0.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patients, physicians, and inventory items.
 * Patients can only access their own visit history.
 *
 * Data Structure:
 * - /patients/{patientId}: Stores patient information.
 * - /patients/{patientId}/visits/{visitId}: Stores visit information for a specific patient.
 * - /physicians/{physicianId}: Stores physician information.
 * - /appointments/{appointmentId}: Stores appointment information.
 * - /inventory_items/{inventoryItemId}: Stores inventory items.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed for privacy.
 * - All writes require a verified user identity (request.auth != null).
 * - get() calls are avoided to improve rule performance. All necessary authorization data is denormalized onto the documents.
 *
 * Denormalization for Authorization:
 *  - The structure uses path-based ownership for patient and visit data.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /patients/{patientId} collection.
     * @path /patients/{patientId}
     * @allow (create) Signed-in user creates a patient document where patientId matches their UID.
     * @allow (get, update, delete) Signed-in user with matching UID reads, updates, or deletes their patient document.
     * @deny (create) User attempts to create a patient document with a mismatched patientId.
     * @principle Enforces document ownership for writes.
     */
    match /patients/{patientId} {
      allow get: if isOwner(patientId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.id == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(patientId);
    }

    /**
     * @description Rules for the /patients/{patientId}/visits/{visitId} collection.
     * @path /patients/{patientId}/visits/{visitId}
     * @allow (create) Signed-in user creates a visit document under their patient document.
     * @allow (get, list, update, delete) Signed-in user with matching patientId reads, lists, updates, or deletes visit documents under their patient document.
     * @deny (create) User attempts to create a visit document under a different patient's document.
     * @principle Restricts access to a user's own data tree.
     */
    match /patients/{patientId}/visits/{visitId} {
      allow get: if isSignedIn() && isOwner(patientId);
      allow list: if isSignedIn() && isOwner(patientId);
      allow create: if isSignedIn() && isOwner(patientId) && request.resource.data.patientId == patientId;
      allow update: if isExistingOwner(patientId) && request.resource.data.patientId == patientId && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isExistingOwner(patientId) && request.resource.data.patientId == patientId;
    }

    /**
     * @description Rules for the /appointments/{appointmentId} collection.
     * @path /appointments/{appointmentId}
     * @allow (create, get, list, update, delete) Any signed-in user can create, read, update, or delete appointment documents.
     * @principle Allows open read and write access to appointments for authenticated users.
     */
    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /inventory_items/{inventoryItemId} collection.
     * @path /inventory_items/{inventoryItemId}
     * @allow (create, get, list, update, delete) Signed-in user can create, read, update, or delete inventory item documents.
     * @principle Requires authentication for all operations on inventory items.
     */
    match /inventory_items/{inventoryItemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Rules for the /physicians/{physicianId} collection.
     * @path /physicians/{physicianId}
     * @allow (create) Signed-in user creates a physician document where physicianId matches their UID.
     * @allow (get, update, delete) Signed-in user with matching physicianId reads, updates, or deletes their physician document.
     * @deny (create) User attempts to create a physician document with a mismatched physicianId.
     * @principle Enforces document ownership for writes.
     */
    match /physicians/{physicianId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isOwner(physicianId) && request.resource.data.id == physicianId;
      allow update: if isExistingOwner(physicianId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(physicianId);
    }
  }
}